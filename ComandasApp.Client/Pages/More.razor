@page "/more"
@layout ComandasApp.Client.Layout.EmptyLayout

<PageTitle>Más - ComandasApp</PageTitle>

<div class="bg-surface text-on-surface font-body min-h-screen flex flex-col antialiased pb-24">
    <!-- Header -->
    <header class="w-full top-0 sticky bg-surface-container-lowest shadow-sm flex justify-between items-center px-4 py-4 z-40 border-b border-surface-variant">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">person</span>
            </div>
            <h1 class="font-headline text-[22px] font-bold text-primary leading-tight">ComandasApp</h1>
        </div>
        <button class="w-10 h-10 flex items-center justify-center text-on-surface hover:bg-surface-container-high rounded-full transition-colors">
            <span class="material-symbols-outlined">settings</span>
        </button>
    </header>

    <main class="flex-grow p-4 overflow-y-auto space-y-6">
        <!-- Profile Card -->
        <div class="bg-surface-container-lowest rounded-3xl shadow-sm border border-surface-variant p-5 flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-[#32524a] text-white flex items-center justify-center text-2xl font-bold">
                U
            </div>
            <div>
                <h2 class="font-headline text-[20px] font-bold text-on-surface">Usuario</h2>
                <p class="text-[14px] text-on-surface-variant">Jefe de Sala</p>
            </div>
        </div>

        <!-- Menu List -->
        <div class="bg-surface-container-lowest rounded-3xl shadow-sm border border-surface-variant overflow-hidden">
            <button class="w-full flex items-center justify-between p-5 border-b border-surface-variant/50 hover:bg-surface-container-high transition-colors active:bg-surface-container-highest">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-[20px]">history</span>
                    </div>
                    <span class="font-medium text-[16px] text-on-surface">Historial pedidos</span>
                </div>
                <span class="material-symbols-outlined text-on-surface-variant text-[20px]">chevron_right</span>
            </button>
            <button class="w-full flex items-center justify-between p-5 border-b border-surface-variant/50 hover:bg-surface-container-high transition-colors active:bg-surface-container-highest">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-[20px]">bar_chart</span>
                    </div>
                    <span class="font-medium text-[16px] text-on-surface">Estadísticas</span>
                </div>
                <span class="material-symbols-outlined text-on-surface-variant text-[20px]">chevron_right</span>
            </button>
            <button class="w-full flex items-center justify-between p-5 hover:bg-surface-container-high transition-colors active:bg-surface-container-highest">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-[20px]">help_outline</span>
                    </div>
                    <span class="font-medium text-[16px] text-on-surface">Ayuda</span>
                </div>
                <span class="material-symbols-outlined text-on-surface-variant text-[20px]">chevron_right</span>
            </button>
        </div>

        <!-- Cerrar Sesión Button -->
        <button class="w-full flex items-center justify-center gap-2 p-4 rounded-3xl bg-surface-container font-medium text-error hover:bg-surface-container-high transition-colors active:scale-[0.98] shadow-sm">
            <span class="material-symbols-outlined text-[20px] rotate-180">logout</span>
            Cerrar Sesión
        </button>

        <!-- Footer Info -->
        <div class="text-center text-[12px] text-on-surface-variant mt-10 space-y-1 opacity-70">
            <p class="font-semibold tracking-widest text-[11px]">COMANDASAPP</p>
            <p>Versión 1.0</p>
            <p>© 2026 Juan Fernando Portilla</p>
            <p>jfportilla@unicauca.edu.co</p>
        </div>
    </main>
</div>
