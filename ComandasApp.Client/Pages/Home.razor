@page "/"
@layout ComandasApp.Client.Layout.EmptyLayout
@inject HttpClient Http

<PageTitle>ComandasApp</PageTitle>

<style>
    /* Custom Utilities to supplement config */
    .rounded-t-super { border-top-left-radius: 1.5rem; border-top-right-radius: 1.5rem; }
    .text-body-lg { font-size: 18px; line-height: 1.6; }
    .text-body-md { font-size: 16px; line-height: 1.6; }
    .text-body-sm { font-size: 14px; line-height: 1.4; }
    .text-headline-md { font-size: 24px; line-height: 1.4; }
    
    /* Hide scrollbar for clean UI */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="min-h-screen flex flex-col pb-[80px] md:pb-0">
    <!-- TopAppBar -->
    <header class="w-full top-0 sticky bg-surface shadow-sm flex justify-between items-center px-container-padding py-unit w-full max-w-full z-40">
        <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-surface-variant overflow-hidden border border-outline-variant flex items-center justify-center text-on-surface-variant">
                <span class="material-symbols-outlined" data-icon="person">person</span>
            </div>
            <div>
                <h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">ComandasApp</h1>
            </div>
        </div>
        <button aria-label="Search" class="text-primary hover:bg-surface-container-low transition-colors active:scale-95 duration-150 p-2 rounded-full flex items-center justify-center">
            <span class="material-symbols-outlined" data-icon="search">settings</span>
        </button>
    </header>

    <section class="px-container-padding py-4 flex justify-between items-center bg-surface">
        <div class="flex flex-col">
            <h2 class="font-headline-md text-[24px] font-bold text-on-surface">Mesas</h2>
            <p class="font-body-md text-on-surface-variant">Mapeo de mesas</p>
        </div>
        <button class="flex items-center gap-2 px-4 py-2 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined text-[20px]">filter_list</span>
            <span class="font-label-sm">Filtrar</span>
        </button>
    </section>

    <!-- Main Content -->
    <main class="flex-grow p-container-padding grid grid-cols-2 gap-4 max-w-7xl mx-auto w-full">
        <!-- Mesa Libre (Ejemplo con lógica dinámica) -->
        <div class="bg-surface-container-lowest rounded-xl border border-surface-variant p-4 shadow-[0px_4px_20px_rgba(0,0,0,0.04)] flex flex-col justify-between hover:shadow-[0px_10px_30px_rgba(0,0,0,0.08)] transition-shadow opacity-70 relative overflow-hidden aspect-square cursor-pointer group"
             @onclick="() => SeleccionarMesa(10)">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-outline-variant"></div>
            <div class="flex justify-between items-start z-10 pl-2">
                <span class="font-headline-md text-headline-md text-on-surface-variant leading-none">M10</span>
                <div class="px-2 py-1 rounded border border-transparent">
                    <span class="font-label-sm text-label-sm text-outline">Libre</span>
                </div>
            </div>
            <div class="flex-1 flex items-center justify-center z-10 pl-2">
                <span class="material-symbols-outlined text-[40px] text-surface-container-high group-hover:text-surface-variant transition-colors">table_restaurant</span>
            </div>
            <div class="mt-auto pt-3 border-t border-surface-container-high z-10 flex justify-center pl-2">
                <span class="font-label-sm text-label-sm text-on-surface-variant group-hover:text-primary transition-colors">Simular Pedido M10</span>
            </div>
        </div>

        <!-- Mesa Activa (Ejemplo estático) -->
        <div class="bg-secondary-container rounded-xl border border-primary p-4 shadow-[0px_4px_20px_rgba(0,0,0,0.04)] flex flex-col justify-between relative overflow-hidden aspect-square cursor-pointer group ring-2 ring-primary ring-opacity-50">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-primary"></div>
            <div class="absolute -left-2 top-0 bottom-0 w-4 bg-primary blur-md opacity-30"></div>
            <div class="flex justify-between items-start z-10 pl-2">
                <span class="font-headline-md text-headline-md text-on-secondary-container leading-none">M5</span>
                <div class="bg-primary px-2 py-1 rounded border border-primary-container">
                    <span class="font-label-sm text-label-sm text-on-primary">Pidiendo</span>
                </div>
            </div>
            <div class="flex items-center gap-2 z-10 pl-2 mt-2">
                <span class="material-symbols-outlined text-on-secondary-container opacity-70 text-[20px]">group</span>
                <span class="font-body-md text-body-md text-on-secondary-container">3 Pax</span>
            </div>
            <div class="mt-auto pt-3 border-t border-primary z-10 flex justify-between items-center pl-2">
                <span class="font-label-sm text-label-sm text-on-secondary-container font-bold">3 Ítems</span>
                <button class="bg-primary text-on-primary px-3 py-2 rounded-lg hover:bg-primary-container hover:text-on-primary-container transition-colors font-label-sm text-label-sm shadow-sm flex items-center gap-1">
                    Revisar
                </button>
            </div>
        </div>
    </main>

    @if (mesaSeleccionada != null)
    {
        <!-- Blurred Background Context -->
        <div class="fixed inset-0 z-[60] bg-on-surface/40 backdrop-blur-sm transition-opacity" @onclick="() => mesaSeleccionada = null"></div>

        <!-- Bottom Sheet Modal Container -->
        <div class="fixed bottom-0 left-0 w-full z-[70] bg-surface-container-lowest rounded-t-super shadow-[0px_-10px_40px_rgba(0,0,0,0.15)] flex flex-col max-h-[92vh] md:max-w-md md:left-1/2 md:-translate-x-1/2 md:rounded-xl md:bottom-auto md:top-1/2 md:-translate-y-1/2">
            <!-- Drag Handle (Mobile only) -->
            <div class="w-full flex justify-center pt-3 pb-1 md:hidden">
                <div class="w-12 h-1.5 bg-outline-variant rounded-full opacity-50"></div>
            </div>
            
            <!-- Header -->
            <div class="px-6 pt-4 pb-3 flex items-center justify-between bg-surface-container-lowest">
                <div class="flex flex-col">
                    <span class="text-outline font-label text-[12px] uppercase tracking-wider">Ubicación</span>
                    <h2 class="font-headline text-headline-md font-semibold text-on-surface">Mesa @mesaSeleccionada</h2>
                </div>
                <button @onclick="() => mesaSeleccionada = null" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="w-full h-[1px] bg-surface-variant"></div>

            <!-- Scrollable Menu Content -->
            <div class="flex-1 overflow-y-auto no-scrollbar px-6 py-5 space-y-8 bg-surface-container-lowest">
                <!-- Section 1: Entrada -->
                <section>
                    <h3 class="font-headline text-body-lg font-medium text-primary mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">restaurant</span>
                        Entrada
                        <button class="ml-auto w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors text-outline">
                            <span class="material-symbols-outlined text-[20px]">edit</span>
                        </button>
                    </h3>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="relative block cursor-pointer group">
                            <input checked="" class="peer sr-only" name="entrada" type="radio">
                            <div class="h-full flex flex-col p-4 rounded-xl border border-outline-variant bg-surface-bright group-hover:bg-surface-container-low transition-all duration-200 peer-checked:border-primary peer-checked:bg-primary-fixed/20 peer-checked:shadow-sm">
                                <div class="flex justify-between items-start mb-3">
                                    <span class="material-symbols-outlined text-outline peer-checked:text-primary transition-colors">soup_kitchen</span>
                                    <div class="w-5 h-5 rounded-full border-2 border-outline-variant peer-checked:border-primary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-body-md font-medium text-on-surface peer-checked:text-primary">Sopa</span>
                            </div>
                        </label>
                        <label class="relative block cursor-pointer group">
                            <input class="peer sr-only" name="entrada" type="radio">
                            <div class="h-full flex flex-col p-4 rounded-xl border border-outline-variant bg-surface-bright group-hover:bg-surface-container-low transition-all duration-200 peer-checked:border-primary peer-checked:bg-primary-fixed/20 peer-checked:shadow-sm">
                                <div class="flex justify-between items-start mb-3">
                                    <span class="material-symbols-outlined text-outline peer-checked:text-primary transition-colors">nutrition</span>
                                    <div class="w-5 h-5 rounded-full border-2 border-outline-variant peer-checked:border-primary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-body-md font-medium text-on-surface peer-checked:text-primary">Fruta</span>
                            </div>
                        </label>
                    </div>
                </section>

                <!-- Section 2: Principio -->
                <section>
                    <h3 class="font-headline text-body-lg font-medium text-primary mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">skillet</span>
                        Principio
                    </h3>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="relative block cursor-pointer group">
                            <input class="peer sr-only" name="principio" type="radio">
                            <div class="h-full flex flex-col p-4 rounded-xl border border-outline-variant bg-surface-bright group-hover:bg-surface-container-low transition-all duration-200 peer-checked:border-primary peer-checked:bg-primary-fixed/20 peer-checked:shadow-sm">
                                <div class="flex justify-between items-start mb-3">
                                    <span class="material-symbols-outlined text-outline peer-checked:text-primary transition-colors">grain</span>
                                    <div class="w-5 h-5 rounded-full border-2 border-outline-variant peer-checked:border-primary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-body-md font-medium text-on-surface peer-checked:text-primary">Frijol</span>
                            </div>
                        </label>
                        <label class="relative block cursor-pointer group">
                            <input checked="" class="peer sr-only" name="principio" type="radio">
                            <div class="h-full flex flex-col p-4 rounded-xl border border-outline-variant bg-surface-bright group-hover:bg-surface-container-low transition-all duration-200 peer-checked:border-primary peer-checked:bg-primary-fixed/20 peer-checked:shadow-sm">
                                <div class="flex justify-between items-start mb-3">
                                    <span class="material-symbols-outlined text-outline peer-checked:text-primary transition-colors">ramen_dining</span>
                                    <div class="w-5 h-5 rounded-full border-2 border-outline-variant peer-checked:border-primary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-body-md font-medium text-on-surface peer-checked:text-primary">Fideos</span>
                            </div>
                        </label>
                    </div>
                </section>

                <!-- Section 3: Proteína -->
                <section>
                    <h3 class="font-headline text-body-lg font-medium text-primary mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">set_meal</span>
                        Proteína
                    </h3>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="relative block cursor-pointer group">
                            <input checked="" class="peer sr-only" name="proteina" type="radio">
                            <div class="h-full flex flex-col p-4 rounded-xl border border-outline-variant bg-surface-bright group-hover:bg-surface-container-low transition-all duration-200 peer-checked:border-primary peer-checked:bg-primary-fixed/20 peer-checked:shadow-sm">
                                <div class="flex justify-between items-start mb-3">
                                    <span class="material-symbols-outlined text-outline peer-checked:text-primary transition-colors">kebab_dining</span>
                                    <div class="w-5 h-5 rounded-full border-2 border-outline-variant peer-checked:border-primary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-body-md font-medium text-on-surface peer-checked:text-primary">Carne de Res</span>
                            </div>
                        </label>
                        <label class="relative block cursor-pointer group">
                            <input class="peer sr-only" name="proteina" type="radio">
                            <div class="h-full flex flex-col p-4 rounded-xl border border-outline-variant bg-surface-bright group-hover:bg-surface-container-low transition-all duration-200 peer-checked:border-primary peer-checked:bg-primary-fixed/20 peer-checked:shadow-sm">
                                <div class="flex justify-between items-start mb-3">
                                    <span class="material-symbols-outlined text-outline peer-checked:text-primary transition-colors">egg_alt</span>
                                    <div class="w-5 h-5 rounded-full border-2 border-outline-variant peer-checked:border-primary flex items-center justify-center transition-colors">
                                        <div class="w-2.5 h-2.5 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    </div>
                                </div>
                                <span class="font-body text-body-md font-medium text-on-surface peer-checked:text-primary">Pollo sudado</span>
                            </div>
                        </label>
                    </div>
                </section>

                <!-- Bottom Spacer for visual breathing room before footer -->
                <section>
                    <h3 class="font-headline text-body-lg font-medium text-primary mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">notes</span>
                        Observaciones
                    </h3>
                    <div class="relative">
                        <textarea placeholder="¿Alguna instrucción especial? (ej. sin cebolla...)" class="w-full min-h-[100px] p-4 rounded-xl border border-outline-variant bg-surface-bright font-body text-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all resize-none placeholder:text-outline/60"></textarea>
                    </div>
                </section>
                <div class="h-4"></div>
            </div>

            <!-- Sticky Action Footer -->
            <div class="p-4 bg-surface-container-lowest border-t border-surface-variant md:rounded-b-xl z-20 shadow-[0px_-4px_16px_rgba(0,0,0,0.03)] pb-safe">
                <button @onclick="EnviarPedidoACocina" class="w-full bg-primary text-on-primary font-headline text-body-md font-medium py-3.5 rounded-xl flex items-center justify-center gap-2 active:scale-[0.98] transition-transform shadow-sm hover:bg-primary-container hover:text-on-primary-container">
                    @if(isSubmitting) {
                        <span class="material-symbols-outlined text-[20px] animate-spin" style="font-variation-settings: 'FILL' 1;">sync</span>
                        <span>Enviando...</span>
                    } else {
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                        <span>Confirmar Pedido</span>
                    }
                </button>
            </div>
        </div>
    }

    <!-- BottomNavBar (Mobile Only) -->
    <nav class="bg-surface text-primary font-label-sm text-label-sm fixed bottom-0 w-full rounded-t-xl z-50 shadow-[0px_-4px_20px_rgba(0,0,0,0.04)] fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-3 pb-safe md:hidden">
        <button class="flex flex-col items-center justify-center text-on-secondary-fixed-variant px-6 py-2 hover:bg-surface-container-high active:scale-90 transition-transform">
            <span class="material-symbols-outlined" data-icon="receipt_long">receipt_long</span>
            <span class="mt-1">Pedidos</span>
        </button>
        <button class="flex flex-col items-center justify-center bg-secondary-container text-on-secondary-container rounded-full px-6 py-2 hover:bg-surface-container-high active:scale-90 transition-transform">
            <span class="material-symbols-outlined" data-icon="table_restaurant">table_restaurant</span>
            <span class="mt-1">Mesas</span>
        </button>
        <button class="flex flex-col items-center justify-center text-on-secondary-fixed-variant px-6 py-2 hover:bg-surface-container-high active:scale-90 transition-transform">
            <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
            <span class="mt-1">Alertas</span>
        </button>
    </nav>
</div>

@code {
    private int? mesaSeleccionada = null;
    private bool isSubmitting = false;

    private void SeleccionarMesa(int numeroMesa)
    {
        mesaSeleccionada = numeroMesa;
    }

    private async Task EnviarPedidoACocina()
    {
        if (mesaSeleccionada == null) return;

        isSubmitting = true;
        
        // Simular petición GraphQL cruda mediante HttpClient
        var query = new
        {
            query = "mutation { createOrder(input: { tableNumber: \"" + mesaSeleccionada.ToString() + "\", customerName: \"Mesa " + mesaSeleccionada + "\", items: [ { productId: \"00000000-0000-0000-0000-000000000000\", quantity: 1, unitPrice: 15.5 } ] }) }"
        };

        try
        {
            await Http.PostAsJsonAsync("/graphql", query);
        }
        catch(Exception)
        {
            // Error handling simulado
        }
        
        isSubmitting = false;
        mesaSeleccionada = null; // Cerramos el panel flotante
    }
}
