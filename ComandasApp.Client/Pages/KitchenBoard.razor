@page "/kitchen"
@layout ComandasApp.Client.Layout.EmptyLayout
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>Pedidos - Estado y Prioridad</PageTitle>

<div class="bg-surface text-on-surface font-body min-h-screen flex flex-col antialiased pb-24">
    <!-- TopAppBar -->
    <header class="w-full top-0 sticky bg-surface-container-lowest shadow-sm flex flex-col px-4 py-4 z-40 border-b border-surface-variant gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-surface-variant overflow-hidden border border-outline-variant flex items-center justify-center text-on-surface-variant">
                <span class="material-symbols-outlined" data-icon="person">person</span>
            </div>
            <div>
                <h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Pedidos</h1>
                <p class="font-label text-[14px] text-on-surface-variant">Estado y Prioridad</p>
            </div>
            <div class="ml-auto">
                <button class="border border-outline px-3 py-1.5 rounded-lg flex items-center gap-2 text-sm font-medium">
                    <span class="material-symbols-outlined text-[18px]">filter_list</span> Filtrar
                </button>
            </div>
        </div>

        <!-- Pills / Tabs -->
        <div class="flex gap-2 overflow-x-auto pb-1 hide-scrollbar">
            <button class="bg-surface-container-high text-on-surface px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap">
                Todos (@orders.Count)
            </button>
            <button class="border border-outline text-on-surface-variant px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-primary"></span> Listo (@orders.Count(o => o.Status == "Listo"))
            </button>
            <button class="border border-outline text-on-surface-variant px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-orange-500"></span> Espera (@orders.Count(o => o.Status == "Preparando"))
            </button>
            <button class="border border-outline text-on-surface-variant px-4 py-1.5 rounded-full text-sm font-medium whitespace-nowrap flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-error"></span> Nuevos (@orders.Count(o => o.Status == "Nuevo"))
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <!-- Main Content -->
    <main class="flex-grow p-4 overflow-y-auto space-y-6">
        @{
            var pedidosActivos = orders.Where(o => o.Status == "Nuevo" || o.Status == "Preparando").ToList();
            var pedidosRealizados = orders.Where(o => o.Status == "Listo").ToList();
        }

        @if (!orders.Any())
        {
            <div class="h-64 flex flex-col items-center justify-center text-center opacity-60">
                <span class="material-symbols-outlined text-[64px] mb-4">check_circle</span>
                <h2 class="text-[18px] font-medium">Todo bajo control</h2>
                <p class="text-[14px]">No hay pedidos pendientes</p>
            </div>
        }
        else
        {
            @if (pedidosActivos.Any())
            {
                <section>
                    <h2 class="font-headline text-[18px] font-bold text-on-surface mb-4">Pedidos Activos</h2>
                    <div class="space-y-4">
                        @foreach (var order in pedidosActivos)
                        {
                            var isNuevo = order.Status == "Nuevo";
                            var isPreparando = order.Status == "Preparando";
                            
                            var borderColor = isNuevo ? "border-l-error" : "border-l-orange-500";
                            var timeBg = isNuevo ? "bg-error/10 text-error border-error/20" : "bg-orange-500/10 text-orange-600 border-orange-500/20";
                            var elapsedMinutes = (int)(DateTime.UtcNow - order.CreatedAt).TotalMinutes;

                            <div class="bg-surface-container-lowest rounded-2xl border-l-[6px] @borderColor shadow-sm p-4 relative border-y border-r border-surface-variant">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-2">
                                        <h4 class="font-headline text-[20px] font-bold text-on-surface">Mesa @order.TableNumber</h4>
                                        <span class="text-on-surface-variant text-sm">#@order.Id.ToString().Substring(0,4).ToUpper()</span>
                                    </div>
                                    <div class="border @timeBg px-2 py-1 rounded-md text-[14px] font-semibold flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[16px]">schedule</span>
                                        <span>@(elapsedMinutes)m</span>
                                    </div>
                                </div>

                                <!-- Items -->
                                <div class="space-y-3 mb-5 border-t border-surface-variant/50 pt-3">
                                    @foreach(var item in order.Items)
                                    {
                                        <div class="flex justify-between items-start text-[15px]">
                                            <div class="flex gap-2">
                                                <span class="font-semibold text-on-surface-variant">@(item.Quantity)x</span>
                                                <div>
                                                    <span class="text-on-surface">@item.ProductName</span>
                                                    @if(!string.IsNullOrEmpty(item.Notes)) {
                                                        <p class="text-[13px] text-outline italic">@item.Notes</p>
                                                    }
                                                </div>
                                            </div>
                                            <span class="font-medium text-on-surface">@item.UnitPrice.ToString("C0")</span>
                                        </div>
                                    }
                                </div>

                                <!-- Botones de Acción -->
                                <div class="flex gap-3 justify-end items-center">
                                    @if (isNuevo)
                                    {
                                        <button class="px-4 py-2 text-error font-medium border border-error/30 rounded-xl">Cancelar</button>
                                        <button class="bg-error text-on-error px-6 py-2.5 rounded-xl font-medium shadow-sm active:scale-95 transition-transform" @onclick='() => CambiarEstado(order.Id, "Preparando")'>
                                            Comenzar
                                        </button>
                                    }
                                    else if (isPreparando)
                                    {
                                        <button class="bg-orange-500 text-white px-6 py-2.5 rounded-xl font-medium shadow-sm active:scale-95 transition-transform w-full sm:w-auto" @onclick='() => CambiarEstado(order.Id, "Listo")'>
                                            Marcar Listo
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            @if (pedidosRealizados.Any())
            {
                <section class="@(pedidosActivos.Any() ? "mt-8" : "")">
                    <h2 class="font-headline text-[18px] font-bold text-on-surface mb-4">Pedidos Realizados</h2>
                    <div class="space-y-4">
                        @foreach (var order in pedidosRealizados)
                        {
                            <div class="bg-surface-container-lowest rounded-2xl border-l-[6px] border-l-[#42615c] shadow-sm p-4 relative border-y border-r border-surface-variant opacity-90">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-2">
                                        <h4 class="font-headline text-[20px] font-bold text-on-surface-variant">Mesa @order.TableNumber</h4>
                                        <span class="text-outline text-sm">#@order.Id.ToString().Substring(0,4).ToUpper()</span>
                                    </div>
                                    <div class="bg-[#42615c] text-white px-3 py-1.5 rounded-lg text-[14px] font-semibold flex items-center gap-1 shadow-sm">
                                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                        <span>Listo</span>
                                    </div>
                                </div>

                                <!-- Items Realizados (Tachados) -->
                                <div class="space-y-3 border-t border-surface-variant/50 pt-3">
                                    @foreach(var item in order.Items)
                                    {
                                        <div class="flex justify-between items-start text-[15px] text-on-surface-variant line-through decoration-on-surface-variant/50">
                                            <div class="flex gap-2">
                                                <span class="font-semibold opacity-70">@(item.Quantity)x</span>
                                                <div>
                                                    <span class="">@item.ProductName</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    </main>
</div>

@code {
    private HubConnection? hubConnection;
    private List<OrderNotification> orders = new();
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await CargarComandasActivas();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/orderhub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<Guid, string>("OrderCreated", async (orderId, tableNumber) =>
        {
            // Recargar todo para tener los items y fechas correctas
            await CargarComandasActivas();
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid, string>("OrderStatusChanged", async (orderId, status) =>
        {
            var order = orders.FirstOrDefault(o => o.Id == orderId);
            if (order != null)
            {
                if (status == "Delivered")
                {
                    orders.Remove(order);
                }
                else
                {
                    order.Status = status == "Preparing" ? "Preparando" : (status == "Ready" ? "Listo" : status);
                }
                await InvokeAsync(StateHasChanged);
            }
        });

        await hubConnection.StartAsync();

        // Timer para actualizar el "minuto transcurrido" cada 30 segundos
        _timer = new System.Threading.Timer(_ => 
        {
            InvokeAsync(StateHasChanged);
        }, null, 0, 30000);
    }

    private async Task CargarComandasActivas()
    {
        try
        {
            var request = new { query = "{ activeOrders { id tableNumber status createdAt items { quantity unitPrice notes product { name } } } }" };
            var response = await Http.PostAsJsonAsync("/graphql", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GraphQLResponse>();
                if (result?.Data?.ActiveOrders != null)
                {
                    orders = result.Data.ActiveOrders.Select(o => new OrderNotification
                    {
                        Id = o.Id,
                        TableNumber = o.TableNumber,
                        Status = o.Status == "PENDING" ? "Nuevo" : (o.Status == "PREPARING" ? "Preparando" : "Listo"),
                        CreatedAt = o.CreatedAt.ToUniversalTime(),
                        Items = o.Items?.Select(i => new OrderItemNotification {
                            Quantity = i.Quantity,
                            UnitPrice = i.UnitPrice,
                            Notes = i.Notes,
                            ProductName = i.Product?.Name ?? "Producto Desconocido"
                        }).ToList() ?? new List<OrderItemNotification>()
                    }).OrderBy(o => o.CreatedAt).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando ordenes: {ex.Message}");
        }
    }

    private async Task CambiarEstado(Guid orderId, string nuevoEstado)
    {
        var order = orders.FirstOrDefault(o => o.Id == orderId);
        if (order != null)
        {
            order.Status = nuevoEstado;
            StateHasChanged(); 
        }

        string graphqlStatus = nuevoEstado == "Preparando" ? "PREPARING" : "READY";
        
        var request = new
        {
            query = $"mutation {{ updateOrderStatus(orderId: \"{orderId}\", newStatus: {graphqlStatus}) }}"
        };

        try
        {
            await Http.PostAsJsonAsync("/graphql", request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error actualizando estado: {ex.Message}");
        }
    }

    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private class OrderNotification
    {
        public Guid Id { get; set; }
        public string TableNumber { get; set; } = string.Empty;
        public string Status { get; set; } = "Nuevo";
        public DateTime CreatedAt { get; set; }
        public List<OrderItemNotification> Items { get; set; } = new();
    }

    private class OrderItemNotification
    {
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public string? Notes { get; set; }
        public string ProductName { get; set; } = string.Empty;
    }

    private class GraphQLResponse
    {
        public GraphQLData? Data { get; set; }
    }

    private class GraphQLData
    {
        public List<OrderDto>? ActiveOrders { get; set; }
    }

    private class OrderDto
    {
        public Guid Id { get; set; }
        public string TableNumber { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public List<OrderItemDto>? Items { get; set; }
    }

    private class OrderItemDto
    {
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public string? Notes { get; set; }
        public ProductDto? Product { get; set; }
    }

    private class ProductDto
    {
        public string Name { get; set; } = string.Empty;
    }
}
